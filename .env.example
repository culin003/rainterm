# Template for .env — copy to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored; this template is committed so the required variables
# are discoverable. Never put real secrets in this file.

# GitHub Personal Access Token with `repo` scope.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repository slug (owner/name) used by scripts/git-push.sh
GITHUB_REPO=culin003/rainterm

# HTTP(S) proxy for GitHub push. Leave empty if your network reaches
# github.com directly. scripts/git-push.sh sources this file with `set -a`,
# so these are auto-exported and git honors them (http_proxy/https_proxy).
# Point at your local Clash/V2Ray, e.g. http://127.0.0.1:7897
http_proxy=
https_proxy=
