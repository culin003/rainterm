<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.raindrop.ui.CredentialDialogController">
    <top>
        <ToolBar>
            <Button fx:id="newButton" text="" onAction="#onNew"/>
            <Button fx:id="deleteButton" text="" onAction="#onDelete"/>
            <Separator/>
            <Button fx:id="saveButton" text="" onAction="#onSave"/>
            <Button fx:id="closeButton" text="" onAction="#onClose"/>
        </ToolBar>
    </top>
    <left>
        <ListView fx:id="credentialList" prefWidth="200"/>
    </left>
    <center>
        <GridPane hgap="10" vgap="10">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="80" prefWidth="100"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
            </columnConstraints>

            <Label fx:id="nameLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label fx:id="typeLabel" text="" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="typeComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label fx:id="usernameLabel" text="" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label fx:id="passwordLabel" text="" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label fx:id="keyPathLabel" text="" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <HBox spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1">
                <TextField fx:id="keyPathField" prefWidth="200"/>
                <Button fx:id="browseButton" text="" onAction="#onBrowseKey"/>
            </HBox>

            <Label fx:id="keyPassLabel" text="" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <PasswordField fx:id="keyPassField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>
    </center>
</BorderPane>
