<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.raindrop.ui.security.MasterPasswordSetupController"
            prefWidth="680" prefHeight="420" minWidth="580" minHeight="340">
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" right="20" bottom="6" left="20"/></padding>
            <Label fx:id="titleLabel" text="" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="descriptionLabel" text="" wrapText="true" style="-fx-text-fill: #888;"/>
        </VBox>
    </top>
    <center>
        <GridPane hgap="10" vgap="10">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="160" prefWidth="180"/>
                <ColumnConstraints minWidth="320" prefWidth="380"/>
            </columnConstraints>

            <Label fx:id="currentPasswordLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label fx:id="newPasswordLabel" text="" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label fx:id="confirmPasswordLabel" text="" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <PasswordField fx:id="confirmField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label fx:id="hintLabel" text="" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="hintField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label fx:id="hintWarningLabel" text=""
                   GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true"
                   style="-fx-text-fill: #888; -fx-font-size: 11px;"/>

            <Label fx:id="statusLabel" text="" GridPane.rowIndex="5" GridPane.columnIndex="0"
                   GridPane.columnSpan="2" wrapText="true" style="-fx-text-fill: #e74c3c;"/>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="20" bottom="15" left="20"/></padding>
            <Button fx:id="okButton" text="" onAction="#onOk" defaultButton="true"/>
            <Button fx:id="cancelButton" text="" onAction="#onCancel" cancelButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
