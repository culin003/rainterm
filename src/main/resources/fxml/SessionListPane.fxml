<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.raindrop.ui.SessionListPaneController"
      prefWidth="330" minWidth="330" maxWidth="330" spacing="4">
    <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    <HBox spacing="4">
        <Label text="Saved Sessions" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+" onAction="#onNew"/>
        <Button text="⟳" onAction="#onRefresh"/>
    </HBox>
    <TextField fx:id="filterField" promptText="Filter..."/>
    <TreeView fx:id="sessionTree" VBox.vgrow="ALWAYS" showRoot="false"/>
</VBox>
